{
  "name": "novel",
  "version": "1.0.0",
  "description": "Notion-style WYSIWYG editor with AI-powered autocompletions",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "lint": "biome lint ./src",
    "format": "biome format ./src "
  },
  "sideEffects": false,
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.1.1",
    "@tiptap/core": "workspace:*",
    "@tiptap/extension-bubble-menu": "workspace:*",
    "@tiptap/extension-character-count": "workspace:*",
    "@tiptap/extension-code-block": "workspace:*",
    "@tiptap/extension-code-block-lowlight": "workspace:*",
    "@tiptap/extension-color": "workspace:*",
    "@tiptap/extension-highlight": "workspace:*",
    "@tiptap/extension-horizontal-rule": "workspace:*",
    "@tiptap/extension-image": "workspace:*",
    "@tiptap/extension-link": "workspace:*",
    "@tiptap/extension-placeholder": "workspace:*",
    "@tiptap/extension-task-item": "workspace:*",
    "@tiptap/extension-task-list": "workspace:*",
    "@tiptap/extension-text-style": "workspace:*",
    "@tiptap/extension-underline": "workspace:*",
    "@tiptap/extension-youtube": "workspace:*",
    "@tiptap/pm": "workspace:*",
    "@tiptap/react": "workspace:*",
    "@tiptap/starter-kit": "workspace:*",
    "@tiptap/suggestion": "workspace:*",
    "@floating-ui/dom": "^1.6.0",
    "@types/node": "^22.10.6",
    "cmdk": "^1.0.4",
    "jotai": "^2.11.0",
    "react-markdown": "^9.0.3",
    "react-moveable": "^0.56.0",
    "react-tweet": "^3.2.1",
    "katex": "^0.16.20",
    "@tiptap/extension-drag-handle": "workspace:*",
    "@tiptap/extension-drag-handle-react": "workspace:*",
    "@tiptap/markdown": "workspace:*",
    "tunnel-rat": "^0.1.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/katex": "^0.16.7",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsconfig": "workspace:*",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3"
  },
  "author": "Steven Tey <stevensteel97@gmail.com>",
  "homepage": "https://novel.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/steven-tey/novel.git"
  },
  "bugs": {
    "url": "https://github.com/steven-tey/novel/issues"
  },
  "keywords": [
    "ai",
    "novel",
    "editor",
    "markdown",
    "nextjs",
    "react"
  ]
}
